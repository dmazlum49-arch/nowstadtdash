# Base44 sandbox defaults — DEVELOPMENT PLACEHOLDERS ONLY.
#
# This file is listed BEFORE /run/base44/app.env in docker-compose.base44.yml,
# so any value you store in the Base44 dashboard (secrets) always wins over the
# values below. It is committed on purpose: docker compose refuses to start if
# an env_file it references is missing.
#
# Local infrastructure credentials (DB_HOST/DB_*/REDIS_*) are NOT here — they
# live inline in docker-compose.base44.yml because a dashboard value must never
# be shadowed by compose `environment:`.

APP_NAME="Nowstadt"
APP_ENV=local
APP_DEBUG=true

# Generated placeholder so the framework can boot in the sandbox. Replace it with
# the project's real key if this workspace ever has to read data that was
# encrypted with it.
APP_KEY=base64:Va/w9H9ODPwx8Z4CWbWp8IhGbF/DvNFUWzKymo0FS2Q=

# The preview proxy serves host port 3000 on this public origin.
APP_URL=https://3000-${BASE44_PUBLIC_HOST_SUFFIX}

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Sandbox-friendly defaults for local work; the app's config/ values apply for
# anything not listed here (session, cache and queue already default to these).
MAIL_MAILER=log
